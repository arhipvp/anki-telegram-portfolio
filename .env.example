TELEGRAM_BOT_TOKEN=
POLZA_AI_API_KEY=
ALLOWED_TELEGRAM_USER_IDS=100000001
# Optional per-user profiles: Telegram ID, target language, and personal Anki deck.
# TELEGRAM_USER_PROFILES=100000001:de:LearnerOne::German,100000002:de:LearnerTwo::German,100000002:en:LearnerTwo::English
ANKI_CONNECT_URL=http://127.0.0.1:8765
ANKI_DECK_NAME=German
ANKI_NOTE_TYPE=German Context v1
POLZA_BASE_URL=https://polza.ai/api/v1
POLZA_TEXT_MODEL=google/gemini-3.5-flash
POLZA_IMAGE_MODEL=google/gemini-2.5-flash-image
POLZA_TRANSCRIPTION_MODEL=openai/gpt-4o-mini-transcribe
APP_DB_PATH=data/app.db
APP_MEDIA_DIR=data/media
FFMPEG_BIN=ffmpeg
VOICE_MAX_BYTES=25000000
APP_LOG_LEVEL=DEBUG
APP_LOG_FILE=logs/app.log
APP_LOG_MAX_BYTES=10485760
APP_LOG_BACKUP_COUNT=5
APP_LOG_FULL_DEBUG=true
